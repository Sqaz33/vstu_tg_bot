# Never commit a real token. Docker Compose also accepts BOT_TOKEN from the shell.
BOT_TOKEN=123456789:replace_me

DATABASE_PATH=/app/data/schedule.db
SOURCE_PAGE_URL=https://www.vstu.ru/student/raspisaniya/zanyatiy/index.php?dep=mag
SOURCE_FILE_PATTERN=1 курс ФЭВТ.xls
UPDATE_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=30
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
LOG_FORMAT=json
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
